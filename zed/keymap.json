[
  {
    "use_key_equivalents": true,
    "bindings": {}
  },
  {
    "context": "vim_mode == normal && !menu",
    "bindings": {
      "cmd f": "file_finder::Toggle",
      "cmd p": "workspace::NewSearch",
      "cmd d": "editor::GoToDefinition",
      "cmd b": "pane::GoBack",
      "cmd n": "pane::GoForward",
      "cmd r": "editor::FindAllReferences",
      "cmd shift-r": "editor::Rename",
      "cmd t": "terminal_panel::ToggleFocus",
      "cmd e": "project_panel::ToggleFocus",
      "cmd g": "git_panel::ToggleFocus",
      "cmd a": ["task::Spawn", { "task_name": "open codex" }],
      "cmd x": "command_palette::Toggle"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "cmd e": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "Dock > Terminal",
    "bindings": {
      "cmd t": "workspace::CloseActiveDock",
      "cmd a": ["task::Spawn", { "task_name": "open codex" }]
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "cmd g": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "cmd a": "workspace::CloseActiveDock"
    }
  }
]
